#!/usr/bin/env python3
"""Can this machine run a check at all? Asked before the check, as a
required preparation step.

    verify/preflight docs [--python <interpreter>]   # markdown-it importable
    verify/preflight backend [--python <interpreter>] [--node <node>] [--tool lsof]
                                                     # node runs, lsof on PATH,
                                                     # markdown-it importable
    verify/preflight browser                         # a Chromium starts, sandboxed
    verify/preflight browser --probe                 # ...and loads and drives the
                                                     # disposable board (task 164)

Bench's own runner records a required preparation step that exits
non-zero as `prepare-failed`, with the check never run. That is the point
of this file: the check's own exit 2 (setup-error) is read by the installed
runner as an ordinary non-zero, i.e. `failed`, because bench has no word
for "the check could not be run" except a preparation that did not
complete. Declaring this as the check's `prepare` is what puts a missing
dependency or a browser that cannot start its sandbox in the right word.

`browser` really launches the browser, with its sandbox, on about:blank
and closes it again. It passes nothing that weakens the sandbox; a host
that cannot provide one fails here, by name, and the check never starts.

Exit 0 ready, 2 not ready. Nothing is installed or downloaded.
"""

import shutil
import subprocess
import sys
from pathlib import Path

# the runner must not leave bytecode in the checkout it is judging
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

import benchverify as bv  # noqa: E402


def body(run: bv.Run) -> str:
    what = run.args.target
    if what == "docs":
        bv.probe_module(run, run.args.require_module)
        return f"{run.args.python} imports {run.args.require_module}"
    if what == "backend":
        # the suite skips, rather than fails, without these; verify/backend
        # refuses any skip, and this says which dependency it was first
        node = shutil.which(run.args.node, path=run.env.get("PATH"))
        version = None
        if node:
            try:
                r = subprocess.run([node, "--version"], env=run.env, cwd=str(run.work),
                                   capture_output=True, text=True, timeout=30)
                version = r.stdout.strip() if r.returncode == 0 else None
            except (OSError, subprocess.TimeoutExpired):
                version = None
        run.record["node"] = {"name": run.args.node, "path": node, "version": version}
        if not version:
            raise bv.SetupError(
                f"no working {run.args.node} on this check's PATH "
                f"({run.env.get('PATH')}): the suite's page-rule tests would skip, and "
                f"verify/backend refuses a skip. Put node on the PATH bench runs checks "
                f"with, or pass --node <path>")
        tools = run.args.tool or ["lsof"]
        found = {t: shutil.which(t, path=run.env.get("PATH")) for t in tools}
        run.record["tools"] = found
        missing = [t for t, where in found.items() if not where]
        if missing:
            raise bv.SetupError(
                f"{', '.join(missing)} not on this check's PATH "
                f"({run.env.get('PATH')}): the tests that need it would skip, and "
                f"verify/backend refuses a skip. Install it, or put it on the PATH "
                f"bench runs checks with")
        bv.probe_module(run, run.args.require_module)
        return (f"{node} {version}; {', '.join(tools)} on PATH; "
                f"{run.args.python} imports {run.args.require_module}")
    if run.args.probe:
        return probe(run)
    if bv.browser_mode() == "remote-playwright":
        argv = bv.remote_setup(run)
        run.record["browser"]["argv"] = argv
        log = run.artifact("browserLog", run.artifacts / "browser.log")
        # origin is never navigated to: this only proves the connection
        browser = bv.RemoteBrowser(argv, run.env, "http://127.0.0.1:9", log)
        browser.close()
        run.record["browser"].update({"serverVersion": browser.version,
                                      "launchOptions": browser.launch_options,
                                      "exposeNetwork": browser.expose_network})
        return (f"{browser.version} answered over the Playwright protocol at "
                f"{run.record['browser']['endpoint']} (sandbox: {bv.REMOTE_SANDBOX})")
    exe, how = bv.find_browser()
    profile = run.work / "profile"
    run.record["browser"] = {"path": exe, "foundBy": how, "sha256": bv.sha256_file(exe),
                             "sandbox": "required (never disabled)",
                             "argv": bv.browser_argv(exe, profile)}
    log = run.artifact("browserLog", run.artifacts / "browser.log")
    # origin is never navigated to: this only proves the browser starts
    browser = bv.Browser(exe, profile, run.env, "http://127.0.0.1:9", log)
    try:
        version = browser.call("Browser.getVersion").get("product")
    finally:
        browser.close()
    run.record["browser"]["version"] = version
    return f"{version} started with its sandbox and answered over CDP"


def probe(run: bv.Run) -> str:
    """`browser --probe` (task 164): the browser, with its sandbox, loads
    the candidate's board from a disposable backend and switches a view
    by a click. A connection that answers is not a browser that can load
    and drive a page; this says which of the three it reached, keeps the
    browser and backend logs and one screenshot, and claims no feature
    coverage."""
    bv.require_paths(run.root, ["manager/core/board.html"])
    mode = bv.browser_mode()
    run.record["browser"] = {"mode": mode}
    run.record["probe"] = {"coverage": {"connection": "not reached",
                                        "navigation": "not reached",
                                        "interaction": "not reached",
                                        "featureCoverage": False,
                                        "limits": bv.PROBE_LIMITS}}
    if mode == "remote-playwright":
        remote = bv.remote_setup(run)
        run.record["browser"]["argv"] = remote
    else:
        exe, how = bv.find_browser()
        run.record["browser"].update({"path": exe, "foundBy": how,
                                      "sha256": bv.sha256_file(exe),
                                      "sandbox": "required (never disabled)"})
    backend = bv.Backend(run.root, run.work / "fixture", run.env, run.args.python)
    run.artifact("backendLog", backend.log)
    browser = None
    try:
        backend.start()
        log = run.artifact("browserLog", run.artifacts / "browser.log")
        if mode == "remote-playwright":
            browser = bv.RemoteBrowser(remote, run.env, backend.url, log)
            run.record["browser"].update({"serverVersion": browser.version,
                                          "launchOptions": browser.launch_options})
        else:
            profile = run.work / "profile"
            run.record["browser"]["argv"] = bv.browser_argv(exe, profile)
            browser = bv.Browser(exe, profile, run.env, backend.url, log)
        try:
            coverage = bv.interaction_probe(browser)
        except bv.SetupError as exc:
            run.record["probe"]["coverage"] = getattr(exc, "coverage", None) or \
                run.record["probe"]["coverage"]
            try:
                browser.screenshot(run.artifact("probeShot",
                                                run.artifacts / "probe-failed.png"))
            except Exception:  # noqa: BLE001 — a crashed page may not answer
                pass
            raise
        run.record["probe"]["coverage"] = coverage
        browser.screenshot(run.artifact("probeShot", run.artifacts / "probe.png"))
    finally:
        if browser is not None:
            browser.close()
        backend.stop()
        if backend.log.exists():
            shutil.copy2(backend.log, run.artifact("backendLog",
                                                   run.artifacts / "backend.log"))
    return ("browser health probe passed: connection, navigation and one "
            "interaction on the disposable board (sandbox kept). " + bv.PROBE_LIMITS)


if __name__ == "__main__":
    run = bv.Run("preflight", __doc__.splitlines()[0], ["manager/core/board.py"])
    run.parser.add_argument("target", choices=("docs", "backend", "browser"))
    run.parser.add_argument("--require-module", default="markdown_it",
                            help="the module the docs builder and the site tests "
                                 "need (default markdown_it)")
    run.parser.add_argument("--node", default="node",
                            help="the node the page-rule tests need (default: "
                                 "node on the check's PATH)")
    run.parser.add_argument("--tool", action="append", metavar="PROGRAM",
                            help="backend only: a program the suite needs on the "
                                 "check's PATH (repeatable; default: lsof, which "
                                 "the stop.sh tests use and skip without)")
    run.parser.add_argument("--probe", action="store_true",
                            help="browser only: also load the disposable board and "
                                 "switch a view by a click (a health probe, not "
                                 "feature coverage)")
    sys.exit(run.main(body))
