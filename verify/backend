#!/usr/bin/env python3
"""Run the candidate's whole unittest suite, as CI does, and say what ran.

    verify/backend                     # the checkout you are standing in
    verify/backend --root <checkout>   # or one you name
    verify/backend --select tests.test_gitrepo [--select …]   # focused

It is `python3 -m unittest discover -s tests -t . -v` in the candidate
root and nothing more — no third-party runner, so the plain command keeps
working without this file — with the child environment built rather than
inherited (see benchverify.py) and the whole log kept.

`--select` (repeatable, at most 32) runs only the named modules, classes
or tests — `tests.test_x`, `tests.test_x.Case`, `tests.test_x.Case.test_y`
— as `python3 -m unittest -v <names>`. The selection is resolved first,
in the candidate, and every name must resolve to at least one test; what
then ran must be exactly what resolved. The record's `coverage` says
`focused` and lists the selection, and the verdict line says it is not a
whole-suite result. Nothing infers a selection from changed files.

Exit 0 when tests ran and all passed, 1 when any failed or errored, 2 when
nothing trustworthy ran: not a bench checkout, zero tests discovered, a
test module that would not import, a selection that names nothing, or
any test skipped. The plain command still reads skips as OK; this one
does not, because the suite's skips are all missing dependencies (node,
markdown-it-py) or platform tools.
"""

import json
import re
import sys
from pathlib import Path

# the runner must not leave bytecode in the checkout it is judging
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

import benchverify as bv  # noqa: E402

TIMEOUT = 3600
RESOLVE_TIMEOUT = 300

# Run in the candidate with the product's interpreter: loads each name and
# prints the test ids it resolves to, or why it resolves to none. Nothing
# is run. One JSON line, after a marker, so import-time output from a test
# module cannot be mistaken for it.
RESOLVE = r"""
import json, sys, unittest
def flat(s):
    for t in s:
        if isinstance(t, unittest.TestSuite):
            yield from flat(t)
        else:
            yield t
out = {}
for name in sys.argv[1:]:
    loader = unittest.TestLoader()
    try:
        suite = loader.loadTestsFromName(name)
    except Exception as exc:
        out[name] = {"ids": [], "error": f"{type(exc).__name__}: {exc}"}
        continue
    ids, errors = [], list(loader.errors)
    for t in flat(suite):
        if type(t).__module__ == "unittest.loader":
            errors.append(str(getattr(t, "_exception", t)))
        else:
            ids.append(t.id())
    out[name] = {"ids": ids, "error": " | ".join(
        e.strip().splitlines()[-1] for e in errors if e.strip()) or None}
print("\nBENCH-VERIFY-SELECTION " + json.dumps(out), flush=True)
"""


def resolve(run: bv.Run, selection: list[str]) -> list[str]:
    """Every selector's test ids, or a setup error naming the selector
    that resolved to none — before a single test runs."""
    for sel in selection:
        parts = sel.split(".")
        if not any((run.root.joinpath(*parts[:i]).with_suffix(".py")).is_file()
                   or (run.root.joinpath(*parts[:i]) / "__init__.py").is_file()
                   for i in range(2, len(parts) + 1)):
            raise bv.SetupError(f"selection {sel!r} names no test module under "
                                f"tests/ in {run.root}: give a module that exists, "
                                f"such as tests.test_gitrepo")
    log = run.artifact("selectionLog", run.artifacts / "selection.log")
    argv = [run.args.python, "-c", RESOLVE, *selection]
    with open(log, "w", encoding="utf-8") as fh:
        code, timed_out = bv.run_group(argv, run.root, run.env, fh, RESOLVE_TIMEOUT)
    text = log.read_text(encoding="utf-8", errors="replace")
    if timed_out:
        raise bv.SetupError(f"resolving the selection did not finish within "
                            f"{RESOLVE_TIMEOUT}s (log {log})")
    line = [ln for ln in text.splitlines() if ln.startswith("BENCH-VERIFY-SELECTION ")]
    if code != 0 or not line:
        raise bv.SetupError(f"the selection could not be resolved (exit {code}): "
                            f"{text.strip()[-600:]} (log {log})")
    found = json.loads(line[-1].split(" ", 1)[1])
    ids: list[str] = []
    for sel in selection:
        got = found.get(sel) or {}
        if got.get("error"):
            raise bv.SetupError(f"selection {sel!r} does not load: {got['error'][:600]} "
                                f"— name a module, class or test that exists")
        if not got.get("ids"):
            raise bv.SetupError(f"selection {sel!r} resolves to zero tests — "
                                f"nothing would be checked")
        ids += got["ids"]
    if len(set(ids)) != len(ids):
        raise bv.SetupError("the selection names some tests twice; name each once")
    return ids


def body(run: bv.Run) -> str:
    selection = bv.validate_selection(
        run.args.select, bv.BACKEND_SELECTOR, "backend",
        "tests.test_gitrepo or tests.test_gitrepo.Case.test_name")
    resolved = resolve(run, selection) if selection else None
    if selection:
        argv = [run.args.python, "-m", "unittest", "-v", *selection]
    else:
        argv = [run.args.python, "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-v"]
    run.record["coverage"] = bv.coverage(selection, len(resolved) if resolved else None, None)
    code, out = run.run_logged(argv, "unittest.log", run.timeout(TIMEOUT))
    ran = re.search(r"^Ran (\d+) tests? in ", out, re.M)
    summary = re.search(r"^(OK|FAILED)( \((.*)\))?\s*$", out, re.M)
    counts = dict(re.findall(r"(failures|errors|skipped|expected failures|"
                             r"unexpected successes)=(\d+)",
                             summary.group(3) or "")) if summary else {}
    # A module unittest could not import is reported as one errored
    # "test" — but nothing in it ran, so it is coverage missing rather
    # than a product failure (usually a dependency this machine lacks).
    unimportable = sorted(set(re.findall(
        r"^(?:ImportError: )?Failed to import test module: (\S+)", out, re.M)))
    causes = sorted(set(re.findall(r"^(\w*(?:Import|NotFound)Error: .+)$", out, re.M))
                    - {f"ImportError: Failed to import test module: {m}"
                       for m in unimportable})
    run.record["tests"] = {
        "ran": int(ran.group(1)) if ran else None,
        **{k.replace(" ", "_"): int(v) for k, v in counts.items()},
        "importFailures": unimportable}
    run.record["coverage"]["ran"] = run.record["tests"]["ran"]
    if not run.record["coverage"]["discovered"]:
        run.record["coverage"]["discovered"] = run.record["tests"]["ran"]
    if not ran:
        raise bv.SetupError(f"unittest printed no 'Ran N tests' line (exit {code}); "
                            f"the suite did not run — see {run.record['artifacts']['log']}")
    n = int(ran.group(1))
    if n == 0:
        raise bv.SetupError("zero tests discovered under tests/ — nothing was checked")
    if unimportable:
        raise bv.SetupError(
            f"{len(unimportable)} test module(s) could not be imported, so their "
            f"tests never ran: {', '.join(unimportable)}"
            + (f" ({'; '.join(causes)[:600]})" if causes else "")
            + f" — install what they need, or fix the import; see "
              f"{run.record['artifacts']['log']}")
    if resolved is not None and n != len(resolved):
        raise bv.SetupError(f"the selection resolved to {len(resolved)} tests but "
                            f"{n} ran; the record would not say what was covered")
    # Strict where the plain command is lenient: a skip is a test that
    # did not run, and in this suite every skip is a dependency or a
    # platform fact this machine lacks (node, markdown-it-py, lsof).
    # "OK (skipped=121)" is not a pass of the whole suite.
    skipped = int(counts.get("skipped", 0))
    reasons = sorted(set(re.findall(r"^(.+? \.\.\. skipped .+)$", out, re.M)))
    run.record["tests"]["skipReasons"] = reasons
    if skipped:
        why = sorted({m.group(1) for r in reasons
                      if (m := re.search(r"skipped (.+)$", r))})
        raise bv.SetupError(
            f"{skipped} of {n} tests skipped, so they never ran: "
            + "; ".join(why)[:600]
            + f" — provide what they need (verify/preflight backend says what is "
              f"missing); see {run.record['artifacts']['log']}")
    if code != 0 or not summary or summary.group(1) != "OK":
        # name what failed, bounded, so a run that cannot open the log
        # still learns which tests to look at
        failed = re.findall(r"^(?:FAIL|ERROR): (\S+ \(\S+\))", out, re.M)
        named = (f"; failing: {', '.join(failed[:20])}"
                 + (f" and {len(failed) - 20} more" if len(failed) > 20 else "")
                 if failed else "")
        raise bv.CheckFailed(f"{n} tests ran, unittest exit {code}: "
                             f"{summary.group(0).strip() if summary else 'no summary'}"
                             f"{named}")
    if selection:
        return (f"{n} tests ran: {summary.group(0).strip()} — focused on "
                f"{', '.join(selection)[:400]}; not a whole-suite result")
    return f"{n} tests ran: {summary.group(0).strip()}"


if __name__ == "__main__":
    run = bv.Run("backend", __doc__.splitlines()[0], ["manager/core/board.py", "tests"])
    run.parser.add_argument(
        "--select", action="append", metavar="TEST",
        help="run only this module, class or test (tests.test_x[.Case[.test_y]]); "
             "repeatable. The record says the run was focused")
    sys.exit(run.main(body))
