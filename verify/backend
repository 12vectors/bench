#!/usr/bin/env python3
"""Run the candidate's whole unittest suite, as CI does, and say what ran.

    verify/backend                     # the checkout you are standing in
    verify/backend --root <checkout>   # or one you name
    verify/backend --select tests.test_gitrepo [--select …]   # focused

It is `python3 -m unittest discover -s tests -t . -v` in the candidate
root and nothing more — no third-party runner, so the plain command keeps
working without this file — with the child environment built rather than
inherited (see benchverify.py) and the whole log kept.

Timing (task 163): by default the whole-suite discovery runs under
verify/unittesttiming.py, which is unittest's own runner and output with a
stopwatch, and writes `timings.json` beside the log — per test, per class
and module fixture, discovery and the whole run — summarised under
`timing` in the record. `--no-timing` runs the plain command instead.
verify/timing-report ranks one run and compares two sets of runs.

`--require-timing` (task 180, the CI leg) makes the timing file part of
the pass: it must have been written by this run, be readable, and name
exactly as many distinct test ids as unittest says ran. Otherwise the run
is a setup error, never a pass. Without it timing stays diagnostics only.
Either way the record's `testSet` names the count and a digest of the
sorted test ids, so two runs can be shown to have covered the same tests.

`--select` (repeatable, at most 32) runs only the named modules, classes
or tests — `tests.test_x`, `tests.test_x.Case`, `tests.test_x.Case.test_y`
— as `python3 -m unittest -v <names>`. The selection is resolved first,
in the candidate, and every name must resolve to at least one test; what
then ran must be exactly what resolved. The record's `coverage` says
`focused` and lists the selection, and the verdict line says it is not a
whole-suite result. Nothing infers a selection from changed files. A
focused run is the plain command, untimed: timing is about the whole
suite, and the record's `timing` says why it was not collected.

Exit 0 when tests ran and all passed, 1 when any failed or errored, 2 when
nothing trustworthy ran: not a bench checkout, zero tests discovered, a
test module that would not import, a selection that names nothing, or
any test skipped. The plain command still reads skips as OK; this one
does not, because the suite's skips are all missing dependencies (node,
markdown-it-py) or platform tools.
"""

import hashlib
import json
import re
import sys
from pathlib import Path

# the runner must not leave bytecode in the checkout it is judging
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

import benchverify as bv  # noqa: E402

TIMEOUT = 3600
RESOLVE_TIMEOUT = 300

# Run in the candidate with the product's interpreter: loads each name and
# prints the test ids it resolves to, or why it resolves to none. Nothing
# is run. One JSON line, after a marker, so import-time output from a test
# module cannot be mistaken for it.
RESOLVE = r"""
import json, sys, unittest
def flat(s):
    for t in s:
        if isinstance(t, unittest.TestSuite):
            yield from flat(t)
        else:
            yield t
out = {}
for name in sys.argv[1:]:
    loader = unittest.TestLoader()
    try:
        suite = loader.loadTestsFromName(name)
    except Exception as exc:
        out[name] = {"ids": [], "error": f"{type(exc).__name__}: {exc}"}
        continue
    ids, errors = [], list(loader.errors)
    for t in flat(suite):
        if type(t).__module__ == "unittest.loader":
            errors.append(str(getattr(t, "_exception", t)))
        else:
            ids.append(t.id())
    out[name] = {"ids": ids, "error": " | ".join(
        e.strip().splitlines()[-1] for e in errors if e.strip()) or None}
print("\nBENCH-VERIFY-SELECTION " + json.dumps(out), flush=True)
"""


def resolve(run: bv.Run, selection: list[str]) -> list[str]:
    """Every selector's test ids, or a setup error naming the selector
    that resolved to none — before a single test runs."""
    for sel in selection:
        parts = sel.split(".")
        if not any((run.root.joinpath(*parts[:i]).with_suffix(".py")).is_file()
                   or (run.root.joinpath(*parts[:i]) / "__init__.py").is_file()
                   for i in range(2, len(parts) + 1)):
            raise bv.SetupError(f"selection {sel!r} names no test module under "
                                f"tests/ in {run.root}: give a module that exists, "
                                f"such as tests.test_gitrepo")
    log = run.artifact("selectionLog", run.artifacts / "selection.log")
    argv = [run.args.python, "-c", RESOLVE, *selection]
    with open(log, "w", encoding="utf-8") as fh:
        code, timed_out = bv.run_group(argv, run.root, run.env, fh, RESOLVE_TIMEOUT)
    text = log.read_text(encoding="utf-8", errors="replace")
    if timed_out:
        raise bv.SetupError(f"resolving the selection did not finish within "
                            f"{RESOLVE_TIMEOUT}s (log {log})")
    line = [ln for ln in text.splitlines() if ln.startswith("BENCH-VERIFY-SELECTION ")]
    if code != 0 or not line:
        raise bv.SetupError(f"the selection could not be resolved (exit {code}): "
                            f"{text.strip()[-600:]} (log {log})")
    found = json.loads(line[-1].split(" ", 1)[1])
    ids: list[str] = []
    for sel in selection:
        got = found.get(sel) or {}
        if got.get("error"):
            raise bv.SetupError(f"selection {sel!r} does not load: {got['error'][:600]} "
                                f"— name a module, class or test that exists")
        if not got.get("ids"):
            raise bv.SetupError(f"selection {sel!r} resolves to zero tests — "
                                f"nothing would be checked")
        ids += got["ids"]
    if len(set(ids)) != len(ids):
        raise bv.SetupError("the selection names some tests twice; name each once")
    return ids


UNITTEST = ["discover", "-s", "tests", "-t", "."]
COLLECTOR = Path(__file__).resolve().parent / "unittesttiming.py"


def timed_argv(run: bv.Run) -> list[str]:
    """The plain command, or the same discovery under the timing
    collector (verify/unittesttiming.py), which runs unittest's own runner
    and output and only adds a stopwatch. The collector lives beside this
    runner, not in the candidate, so any candidate can be timed."""
    plain = [run.args.python, "-m", "unittest", *UNITTEST, "-v"]
    run.record["plainCommand"] = plain
    if run.args.no_timing or not COLLECTOR.is_file():
        run.record["timing"] = {"collected": False,
                                "why": "--no-timing" if run.args.no_timing
                                else f"no collector at {COLLECTOR}"}
        return plain
    path = run.artifact("timings", run.artifacts / "timings.json")
    run.record["timing"] = {"collected": None, "collector": str(COLLECTOR),
                            "collectorSha256": bv.sha256_file(COLLECTOR)}
    return [run.args.python, str(COLLECTOR), "--timings", str(path), *UNITTEST, "-v"]


def record_timing(run: bv.Run) -> None:
    """A summary of the timings file in the record, beside the candidate
    revision and interpreter it is about. Diagnostics only: a missing or
    unreadable file is said, and never changes the outcome."""
    t = run.record.get("timing", {})
    if t.get("collected") is False:
        return
    path = Path(run.record["artifacts"]["timings"])
    try:
        doc = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        t.update(collected=False, why=f"timings file not readable: {exc}")
        return
    secs = {k: round(v, 3) for k, v in doc.get("seconds", {}).items()}
    t.update(collected=True, schema=doc.get("schema"), seconds=secs,
             fixtureTiming=doc.get("fixtureTiming"), counts=doc.get("counts"),
             overhead=doc.get("overhead"), runtime=doc.get("runtime"),
             slowestClasses=[{"class": c["class"], "tests": c["tests"],
                              "seconds": round(c["seconds"], 2),
                              "fixtureSeconds": round(c["fixtureSeconds"], 2)}
                             for c in doc.get("classes", [])[:10]],
             slowestTests=[{"id": x["id"], "seconds": round(x["seconds"], 2)}
                           for x in sorted(doc.get("tests", []),
                                           key=lambda x: -x["seconds"])[:25]],
             slowestFixtures=[{"kind": f["kind"], "owner": f["owner"],
                               "seconds": round(f["seconds"], 2)}
                              for f in sorted(doc.get("fixtures", []),
                                              key=lambda f: -f["seconds"])[:10]])
    # The ranking is printed as well, bounded, because the check's output
    # is what bench keeps in its own evidence log and returns to the run
    # that asked — an artifacts directory may not be readable from there.
    o = doc.get("overhead") or {}
    print(f"timing: elapsed {secs.get('elapsed')}s = discovery {secs.get('discovery')}s + "
          f"tests {secs.get('tests')}s + fixtures {secs.get('fixtures')}s + unattributed "
          f"{secs.get('unattributed')}s; collector overhead "
          f"{o.get('perTestSeconds', 0) * 1e6:.1f}µs/test (measured)")
    for c in doc.get("classes", [])[:15]:
        print(f"timing class: {c['seconds']:7.1f}s {c['tests']:4d} tests "
              f"(fixtures {c['fixtureSeconds']:5.1f}s) {c['class']}")
    for f in t["slowestFixtures"][:6]:
        print(f"timing fixture: {f['seconds']:7.2f}s {f['kind']} {f['owner']}")
    # 25, not 8: the baseline's eight slowest were all one-off waits, and
    # the next tier is what the following improvement needs to see
    for x in t["slowestTests"]:
        print(f"timing test: {x['seconds']:7.2f}s {x['id']}")


def test_set(path: Path, since: float | None, ran: int | None) -> dict:
    """The test ids a timings file names, and whether it can stand behind
    a whole-suite pass: written by this run (`since` is when the run
    started), readable, one entry per test, and as many as unittest said
    ran. Returns {"count", "sha256", "problems"}; it never raises."""
    problems: list[str] = []
    if since is not None:
        try:
            bv.require_fresh([path], since)
        except bv.SetupError as exc:
            problems.append(str(exc))
    try:
        doc = json.loads(Path(path).read_text(encoding="utf-8"))
        ids = [t["id"] for t in doc.get("tests", [])]
    except (OSError, ValueError, TypeError, KeyError, AttributeError) as exc:
        problems.append(f"timings file not readable: {exc}")
        return {"count": None, "sha256": None, "problems": problems}
    if len(set(ids)) != len(ids):
        problems.append("the timings file names some test ids more than once")
    if ran is not None and len(ids) != ran:
        problems.append(f"the timings file names {len(ids)} tests but unittest "
                        f"says {ran} ran")
    digest = hashlib.sha256("\n".join(sorted(ids)).encode("utf-8")).hexdigest()
    return {"count": len(ids), "sha256": digest, "problems": problems}


def body(run: bv.Run) -> str:
    if run.args.require_timing and (run.args.select or run.args.no_timing):
        raise bv.SetupError("--require-timing is for a timed whole-suite run; it cannot "
                            "be combined with --select or --no-timing")
    if run.args.require_timing and not COLLECTOR.is_file():
        raise bv.SetupError(f"--require-timing, and there is no timing collector at "
                            f"{COLLECTOR}")
    selection = bv.validate_selection(
        run.args.select, bv.BACKEND_SELECTOR, "backend",
        "tests.test_gitrepo or tests.test_gitrepo.Case.test_name")
    resolved = resolve(run, selection) if selection else None
    if selection:
        # a focused run is the plain command (task 162's contract); the
        # timing collector is for whole-suite runs (task 163)
        argv = [run.args.python, "-m", "unittest", "-v", *selection]
        run.record["plainCommand"] = argv
        run.record["timing"] = {"collected": False,
                                "why": "a focused selection runs the plain command"}
    else:
        argv = timed_argv(run)
    run.record["coverage"] = bv.coverage(selection, len(resolved) if resolved else None, None)
    code, out = run.run_logged(argv, "unittest.log", run.timeout(TIMEOUT))
    record_timing(run)
    ran = re.search(r"^Ran (\d+) tests? in ", out, re.M)
    summary = re.search(r"^(OK|FAILED)( \((.*)\))?\s*$", out, re.M)
    counts = dict(re.findall(r"(failures|errors|skipped|expected failures|"
                             r"unexpected successes)=(\d+)",
                             summary.group(3) or "")) if summary else {}
    # A module unittest could not import is reported as one errored
    # "test" — but nothing in it ran, so it is coverage missing rather
    # than a product failure (usually a dependency this machine lacks).
    unimportable = sorted(set(re.findall(
        r"^(?:ImportError: )?Failed to import test module: (\S+)", out, re.M)))
    causes = sorted(set(re.findall(r"^(\w*(?:Import|NotFound)Error: .+)$", out, re.M))
                    - {f"ImportError: Failed to import test module: {m}"
                       for m in unimportable})
    run.record["tests"] = {
        "ran": int(ran.group(1)) if ran else None,
        **{k.replace(" ", "_"): int(v) for k, v in counts.items()},
        "importFailures": unimportable}
    run.record["coverage"]["ran"] = run.record["tests"]["ran"]
    timings = run.record.get("artifacts", {}).get("timings")
    tset = (test_set(Path(timings), run.started, run.record["tests"]["ran"])
            if timings else None)
    if tset is not None:
        run.record["testSet"] = {"count": tset["count"], "sha256": tset["sha256"],
                                 "source": "timings.json"}
    if not run.record["coverage"]["discovered"]:
        run.record["coverage"]["discovered"] = run.record["tests"]["ran"]
    if not ran:
        raise bv.SetupError(f"unittest printed no 'Ran N tests' line (exit {code}); "
                            f"the suite did not run — see {run.record['artifacts']['log']}")
    n = int(ran.group(1))
    if n == 0:
        raise bv.SetupError("zero tests discovered under tests/ — nothing was checked")
    if unimportable:
        raise bv.SetupError(
            f"{len(unimportable)} test module(s) could not be imported, so their "
            f"tests never ran: {', '.join(unimportable)}"
            + (f" ({'; '.join(causes)[:600]})" if causes else "")
            + f" — install what they need, or fix the import; see "
              f"{run.record['artifacts']['log']}")
    if resolved is not None and n != len(resolved):
        raise bv.SetupError(f"the selection resolved to {len(resolved)} tests but "
                            f"{n} ran; the record would not say what was covered")
    # Strict where the plain command is lenient: a skip is a test that
    # did not run, and in this suite every skip is a dependency or a
    # platform fact this machine lacks (node, markdown-it-py, lsof).
    # "OK (skipped=121)" is not a pass of the whole suite.
    skipped = int(counts.get("skipped", 0))
    reasons = sorted(set(re.findall(r"^(.+? \.\.\. skipped .+)$", out, re.M)))
    run.record["tests"]["skipReasons"] = reasons
    if skipped:
        why = sorted({m.group(1) for r in reasons
                      if (m := re.search(r"skipped (.+)$", r))})
        raise bv.SetupError(
            f"{skipped} of {n} tests skipped, so they never ran: "
            + "; ".join(why)[:600]
            + f" — provide what they need (verify/preflight backend says what is "
              f"missing); see {run.record['artifacts']['log']}")
    if code != 0 or not summary or summary.group(1) != "OK":
        # name what failed, bounded, so a run that cannot open the log
        # still learns which tests to look at
        failed = re.findall(r"^(?:FAIL|ERROR): (\S+ \(\S+\))", out, re.M)
        named = (f"; failing: {', '.join(failed[:20])}"
                 + (f" and {len(failed) - 20} more" if len(failed) > 20 else "")
                 if failed else "")
        raise bv.CheckFailed(f"{n} tests ran, unittest exit {code}: "
                             f"{summary.group(0).strip() if summary else 'no summary'}"
                             f"{named}")
    if run.args.require_timing:
        # last, so a failing or skipping run says that first; a pass
        # whose timing evidence is missing, stale or about other tests is
        # not a complete pass
        problems = tset["problems"] if tset else ["no timings file was named"]
        if problems:
            raise bv.SetupError("--require-timing: " + "; ".join(problems)[:800])
    if selection:
        return (f"{n} tests ran: {summary.group(0).strip()} — focused on "
                f"{', '.join(selection)[:400]}; not a whole-suite result")
    return f"{n} tests ran: {summary.group(0).strip()}"


if __name__ == "__main__":
    runner = bv.Run("backend", __doc__.splitlines()[0],
                    ["manager/core/board.py", "tests"])
    runner.parser.add_argument(
        "--no-timing", action="store_true",
        help="run the plain `python -m unittest` command, without the timing "
             "collector (timings.json is then not written)")
    runner.parser.add_argument(
        "--require-timing", action="store_true",
        help="a pass also needs a fresh, readable timings.json naming exactly the "
             "tests that ran (the CI leg's contract); otherwise setup-error")
    runner.parser.add_argument(
        "--select", action="append", metavar="TEST",
        help="run only this module, class or test (tests.test_x[.Case[.test_y]]); "
             "repeatable. The record says the run was focused. A focused run "
             "is not timed")
    sys.exit(runner.main(body))
